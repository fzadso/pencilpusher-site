---
layout: base.njk
---
{%- set a = { fileSlug: page.fileSlug, url: page.url, data: { title: title, medium: medium, sizeText: sizeText, year: year, sold: sold, original_price: original_price, canBuyOriginal: canBuyOriginal, canBuyPrint: canBuyPrint, printPrice: printPrice } } -%}
{%- set nb = collections.art | byMedium(medium) | neighbors(page.url) -%}
<nav class="crumbs" aria-label="Browse">
  <a href="/shop/#{{ medium | lower }}">← All {{ medium | lower }}</a>
  {% if nb %}<span class="pn"><a href="{{ nb.prev.url }}" rel="prev" aria-label="Previous: {{ nb.prev.data.title }}">‹ Previous</a><a href="{{ nb.next.url }}" rel="next" aria-label="Next: {{ nb.next.data.title }}">Next ›</a></span>{% endif %}
</nav>
<div class="art-page" data-id="{{ page.fileSlug }}">
  <figure class="art-figure">
    {% if pic %}<picture><source type="image/webp" srcset="{{ pic.webpSrcset }}" sizes="(max-width: 900px) 100vw, 800px"><img src="{{ pic.large }}" srcset="{{ pic.jpegSrcset }}" sizes="(max-width: 900px) 100vw, 800px" alt="{{ title }}, {{ medium | lower }} by {{ settings.artist }}" width="{{ pic.width }}" height="{{ pic.height }}"></picture>{% endif %}
  </figure>
  <div class="card art-side{% if sold %} is-sold{% endif %}" data-id="{{ page.fileSlug }}">
    {% set slot = "page" %}{% include "buy.njk" %}
    {% if content | plain %}<div class="story">{{ content | safe }}</div>{% endif %}
    {% if canBuyPrint %}<p class="note">{{ settings.print_note }}</p>{% endif %}
    {% if settings.shipping_returns %}<details class="policy"><summary>Shipping &amp; returns</summary>{% for para in settings.shipping_returns.split("\n\n") %}<p>{{ para }}</p>{% endfor %}</details>{% endif %}
  </div>
</div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":{{ title | json | safe }},"image":{{ (settings.url + (pic.large if pic else "")) | json | safe }},"description":{{ (medium + " by " + settings.artist + (", " + sizeText + " in" if sizeText else "")) | json | safe }},"brand":{"@type":"Brand","name":{{ settings.site_name | json | safe }}},"offers":{"@type":"Offer","priceCurrency":"USD","price":{{ (original_price if canBuyOriginal else printPrice) or 0 }},"availability":"https://schema.org/InStock","url":{{ (settings.url + page.url) | json | safe }}}}</script>
