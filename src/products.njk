---
permalink: /products.json
eleventyExcludeFromCollections: true
---
{"shipping_print":{{ settings.shipping_print or 0 }},"shipping_original":{{ settings.shipping_original or 0 }},"items":[{% for a in collections.art %}{% set d = a.data %}{"id":{{ a.fileSlug | json | safe }},"title":{{ d.title | json | safe }},"medium":{{ d.medium | json | safe }},"size":{{ (d.sizeText or "") | json | safe }},"url":{{ a.url | json | safe }},"thumb":{{ (d.pic.thumb if d.pic else "") | json | safe }},"original":{{ d.original_price if d.canBuyOriginal else "null" }},"print":{{ d.printPrice if d.canBuyPrint else "null" }}}{% if not loop.last %},{% endif %}{% endfor %}]}
